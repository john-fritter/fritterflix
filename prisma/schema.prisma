generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id
  username  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MovieRating {
  jellyfinItemId String   @id
  johnRating     Decimal? @db.Decimal(3, 1)
  airaRating     Decimal? @db.Decimal(3, 1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
