# Fritterflix Slice 1
# Copy to .env and fill in secrets before running docker compose up -d --build.

POSTGRES_DB=fritterflix
POSTGRES_USER=fritterflix
POSTGRES_PASSWORD=replace-with-a-long-random-password

SESSION_SECRET=replace-with-a-long-random-secret
FRITTERFLIX_ADMIN_PASSWORD=replace-with-admin-password

# In production this can point at the public Caddy route; Fritterflix still never talks to Jellyfin directly.
MEDIA_PROXY_BASE_URL=https://fritter.lol
